# 複製為 .env 後填入實際值（.env 已被 .gitignore 排除，切勿提交真實金鑰）
# 使用方式：node --env-file=.env backend/server.js

# ── 伺服器 ───────────────────────────────
PORT=8080
BASE_URL=                       # 例：https://health-xxxx.a.run.app
TZ_DEFAULT=Asia/Taipei
NODE_ENV=                       # production 時停用 DEV_AUTH_USER_ID
STORAGE=sheets                  # sheets | memory（memory 僅供本機測試）

# ── LINE Messaging API（必填）─────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ADMIN_LINE_USER_ID=             # 系統異常通知對象

# ── Gemini ───────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# ── Google Sheets / Drive ────────────────
SPREADSHEET_ID=                 # STORAGE=sheets 時必填，可由 scripts/setup-sheets.js 產生
DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=         # 電腦版應用程式 OAuth 用戶端
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=     # 由 scripts/get-refresh-token.js 取得

# ── Web Dashboard ────────────────────────
DASHBOARD_GOOGLE_CLIENT_ID=     # 網頁應用程式 OAuth 用戶端（Google Identity Services）
ALLOWED_EMAILS=                 # 逗號分隔，例：you@gmail.com,other@gmail.com
SESSION_SECRET=                 # 必填，長隨機字串
SESSION_HOURS=72

# ── 排程 ─────────────────────────────────
JOB_SECRET=                     # 必填，Cloud Scheduler 呼叫 /jobs/* 時帶入 X-Job-Secret
PENDING_EXPIRE_MINUTES=60       # 待確認動作逾時（分鐘）

# ── 本機開發專用 ─────────────────────────
DEV_AUTH_USER_ID=               # 非 production 時略過 Dashboard 登入，例：U_demo
SEED_DEMO=                      # STORAGE=memory 時設 1 載入示範資料
