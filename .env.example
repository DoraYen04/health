# 複製為 .env 後填入實際值（.env 已被 .gitignore 排除，切勿提交真實金鑰）
# 本機使用：node --env-file=.env backend/server.js
# 雲端部署：金鑰放 Secret Manager，其餘以 --set-env-vars 設定（見 deploy.md）

# ── 伺服器 ───────────────────────────────
PORT=8080
# Dashboard 網址（Firebase Hosting），LINE 訊息裡的「開啟 Dashboard」會連到這裡
BASE_URL=https://dora-health-6a02c.web.app
TZ_DEFAULT=Asia/Taipei
# production 時停用 DEV_AUTH_USER_ID
NODE_ENV=
# sheets | memory（memory 僅供本機測試）
STORAGE=sheets

# ── Google Cloud / Firebase 專案 ─────────
GCP_PROJECT_ID=dora-health-6a02c
# Cloud Run 服務網址（OIDC audience；Cloud Tasks 回呼也用這個網址）
SERVICE_URL=https://health-xxxx.asia-east1.run.app
# Cloud Scheduler 與 Cloud Tasks 呼叫後端所用的服務帳號
INVOKER_SA_EMAIL=health-invoker@dora-health-6a02c.iam.gserviceaccount.com
# LINE 事件佇列（留空＝本機直接處理）
TASKS_QUEUE=
TASKS_LOCATION=asia-east1

# ── LINE Messaging API（Secret Manager）──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 系統異常通知對象（選填）
ADMIN_LINE_USER_ID=

# ── Gemini（Secret Manager）──────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# ── Google Sheets / Drive ────────────────
# STORAGE=sheets 時必填，可由 scripts/setup-sheets.js 產生
SPREADSHEET_ID=
DRIVE_FOLDER_ID=
# 電腦版應用程式 OAuth 用戶端（Secret Manager）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 由 scripts/get-refresh-token.js 取得（Secret Manager）
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Web Dashboard（Firebase Authentication）
# 允許登入的 Google 帳號，逗號分隔，例：you@gmail.com,other@gmail.com
ALLOWED_EMAILS=

# ── 其他 ─────────────────────────────────
# 待確認動作逾時（分鐘）
PENDING_EXPIRE_MINUTES=60

# ── 本機開發專用 ─────────────────────────
# 非 production 時略過 Dashboard 登入，例：U_demo
DEV_AUTH_USER_ID=
# STORAGE=memory 時設 1 載入示範資料
SEED_DEMO=
